<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. Replace REPO and SECRET, then copy to ~/Library/LaunchAgents/ and load it yourself. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.malfoid.yt-push-receiver</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string><string>python3</string>
    <string>REPO/scripts/yt_push/receiver.py</string>
  </array>
  <key>WorkingDirectory</key><string>REPO/scripts/yt_push</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>YT_PUSH_SECRET</key><string>SECRET</string>
    <key>YT_PUSH_PORT</key><string>8787</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>REPO/scripts/yt_push/data/receiver.log</string>
</dict>
</plist>
